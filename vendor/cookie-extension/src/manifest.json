{
  "name": "VOD RIP Get Cookies",
  "short_name": "VOD RIP Cookies",
  "description": "VOD.RIP companion \u2014 export login cookies for YouTube, Twitch and Kick only, and keep the app paired locally.",
  "version": "0.8.33",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "alarms",
    "cookies",
    "downloads",
    "notifications",
    "clipboardWrite",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.twitch.tv/*",
    "https://*.kick.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/videos/*"
      ],
      "js": [
        "clip_assist.mjs"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://clips.twitch.tv/create*"
      ],
      "js": [
        "clip_assist.mjs"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "/images/icon16.png",
      "32": "/images/icon32.png",
      "48": "/images/icon48.png",
      "128": "/images/icon128.png"
    }
  },
  "icons": {
    "16": "/images/icon16.png",
    "32": "/images/icon32.png",
    "48": "/images/icon48.png",
    "128": "/images/icon128.png"
  },
  "incognito": "split",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
