{
  "name": "Kick Overlay",
  "description": "Ad-free Twitch: when a streamer is live on Kick too, plays the Kick livestream over the Twitch player (Kick has no ads). Toggle from the toolbar.",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "*://*.live-video.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors_kick_cdn",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "hls.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kick Overlay",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
