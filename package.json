{
  "name": "vod-rip",
  "private": true,
  "version": "1.0.53",
  "type": "module",
  "scripts": {
    "dev": "npm run verify:install && node scripts/dev-all.mjs",
    "dev:2": "npm run verify:install && node scripts/dev-all.mjs --fast-preview",
    "dev:vite": "npm run verify:install && vite",
    "dev:api": "cd backend && python run.py",
    "dev:all": "npm run verify:install && node scripts/dev-all.mjs",
    "build": "npm run verify:install && vite build",
    "build-copy": "npm run verify:install && vite build && node -e \"const fs=require('fs');const d='backend/static';fs.mkdirSync(d,{recursive:true});fs.copyFileSync('dist/index.html',d+'/index.html')\"",
    "preview": "npm run verify:install && vite preview",
    "verify:install": "node scripts/check-node-install.mjs",
    "typecheck": "node scripts/check-node-install.mjs && tsc --noEmit -p tsconfig.json",
    "test:unit": "node scripts/check-node-install.mjs && vitest run",
    "sync-icon": "python scripts/generate-icon.py",
    "build-dist": "npm run sync-icon && npm run build-copy && pyinstaller vod-rip.spec --noconfirm && node scripts/deploy-dist.mjs && node scripts/stage-cookie-extension.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-release.ps1",
    "build-asr-runtime": "pyinstaller vod-rip-asr.spec --clean --noconfirm && node scripts/deploy-asr-runtime.mjs",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:list": "playwright test --config=e2e/playwright.config.ts --list",
    "test:e2e:frame-live": "playwright test --config=e2e/playwright.config.ts e2e/tests/frame-mode.spec.ts e2e/tests/live-badge.spec.ts"
  },
  "dependencies": {
    "hls.js": "^1.6.2",
    "lucide-react": "^1.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.21",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^4.1.9"
  }
}
